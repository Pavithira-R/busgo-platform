NODE_ENV=development
PORT=3000

# Local PostgreSQL (installed on your machine, or docker-compose.yml)
DATABASE_URL=postgres://busgo:busgo@localhost:5432/busgo

# React dev server
CORS_ORIGIN=http://localhost:5173

# Seed accounts (local development only, use strong values elsewhere)
SEED_ADMIN_EMAIL=admin@busgo.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345

# Login tokens. Generate a secret with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL=1h
